# Frontend settings. Copy to `frontend/.env.local` when running natively.
# Under docker compose these are set by docker-compose.yml instead.
# Values prefixed VITE_ are embedded in the browser bundle: never put secrets in them.

# Base URL of the backend API. Empty means same origin.
VITE_API_BASE_URL=http://localhost:8000

# Dev server only: set to true to poll for file changes (helps with Docker on Windows).
DEV_WATCH_POLLING=false
