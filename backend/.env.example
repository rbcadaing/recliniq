# Backend settings (read by app/core/config.py). Copy to `backend/.env` when running natively.
# Under docker compose these are set by docker-compose.yml instead.
# LOCAL DEVELOPMENT values only. Never commit real secrets.

# Display name returned by the health endpoint and shown in the API docs title.
APP_NAME=RecliniQ
# Deployment environment: local | test | staging | production. Non-local logs as JSON.
APP_ENV=local
# Version string reported by GET /api/v1/health.
APP_VERSION=0.1.0
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# REQUIRED. Async SQLAlchemy URL; must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://recliniq:recliniq@localhost:5432/recliniq
# Log every SQL statement (very noisy; debugging only).
DATABASE_ECHO=false

# Comma-separated browser origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173

# Tests only: a DISPOSABLE database for integration tests (it gets migrated up and down).
# Leave unset to skip integration tests.
# TEST_DATABASE_URL=postgresql+asyncpg://recliniq:recliniq@localhost:5432/recliniq_test

# Dev server only: set to true if uvicorn --reload misses file changes (Docker on Windows).
# WATCHFILES_FORCE_POLLING=false
