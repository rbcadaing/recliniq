# Copy to .env for Docker Compose (do not commit real secrets).

POSTGRES_USER=recliniq
POSTGRES_PASSWORD=recliniq
POSTGRES_DB=recliniq

DATABASE_URL=postgresql+psycopg://recliniq:recliniq@db:5432/recliniq
JWT_SECRET=change-me-in-dev-use-at-least-32-chars
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=/data/uploads

# Seed staff (local only)
SEED_TENANT_NAME=Demo Clinic
SEED_TENANT_TZ=Asia/Manila
SEED_DOCTOR_EMAIL=doctor@example.com
SEED_DOCTOR_PASSWORD=DoctorPass1!
SEED_ASSISTANT_EMAIL=assistant@example.com
SEED_ASSISTANT_PASSWORD=AssistPass1!

# Optional SMTP; if unset, emails are logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@clinic.local

# Browser talks to published API port on the host
VITE_API_URL=http://localhost:8000
