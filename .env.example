# Docker Compose settings for the local stack. Copy to `.env` and adjust if needed.
# These are LOCAL DEVELOPMENT defaults only. Never put production credentials here.

# PostgreSQL user, password, and database created in the `db` container.
POSTGRES_USER=recliniq
POSTGRES_PASSWORD=recliniq
POSTGRES_DB=recliniq

# Host ports published by the stack. Change if they clash with something on your machine.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Mailpit web inbox for emails sent by the local stack.
MAILPIT_UI_PORT=8025

# Signs login access tokens. Any value of 32+ characters works locally; NEVER reuse it elsewhere.
JWT_SECRET=local-compose-jwt-secret-not-for-production-use

# Backend log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Poll for file changes so hot reload works on Docker bind mounts (needed on Windows/macOS).
# Set to false on Linux hosts to save CPU.
DEV_WATCH_POLLING=true
